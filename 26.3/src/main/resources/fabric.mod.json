{
	"schemaVersion": 1,
	"id": "customizable-mobs-health-indicator",
	"version": "${version}",
	"name": "Customizable Mobs Health Indicator",
	"description": "A fully customizable overhead mob health indicator mod for Minecraft.",
	"authors": [
		"RafayShhh"
	],
	"contact": {
		"homepage": "https://github.com/rafayshhh/customizable-mobs-health-indicator",
		"sources": "https://github.com/rafayshhh/customizable-mobs-health-indicator",
		"issues": "https://github.com/rafayshhh/customizable-mobs-health-indicator/issues"
	},
	"license": "MIT",
	"icon": "assets/customizable-mobs-health-indicator/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"io.github.rafayshhh.customizablemobshealthindicator.client.CustomizableMobsHealthIndicatorClient"
		],
		"modmenu": [
			"io.github.rafayshhh.customizablemobshealthindicator.client.integration.ModMenuIntegration"
		]
	},
	"mixins": [
		{
			"config": "customizable-mobs-health-indicator.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
